# Copy to .env. Never commit .env to version control.

# ── MongoDB ──────────────────────────────────────────────────────
# Local (Docker): mongodb://127.0.0.1:27017/cloud2crop
# Atlas example:  mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/cloud2crop?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/cloud2crop

# ── Server ───────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── JWT / Session ────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars

# ── Admin seed account ───────────────────────────────────────────
ADMIN_EMAIL=admin@cloud2crop.in
ADMIN_PASSWORD=Admin@123456

# ── OTP provider ─────────────────────────────────────────────────
# Set OTP_PROVIDER=twilio to use Twilio Verify; leave blank for mock (code: 123456)
OTP_PROVIDER=mock
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── AI Assistant ─────────────────────────────────────────────────
# Anthropic Claude – leave blank to use rules-engine fallback only
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ── Weather refresh cron secret ──────────────────────────────────
CRON_SECRET=change_this_cron_secret

# ── Frontend URL (for CORS) ───────────────────────────────────────
FRONTEND_URL=http://localhost:5173
